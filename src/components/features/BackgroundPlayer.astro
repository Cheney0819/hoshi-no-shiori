---
import { url } from "@/utils/url-utils";

export interface Props {
	playerUrl: string | string[];
	playerMode?: "order" | "random";
}

const { playerUrl, playerMode = "order" } = Astro.props;
const sourceUrls = (Array.isArray(playerUrl) ? playerUrl : [playerUrl])
	.filter(Boolean)
	.map(url);
const mobileMedia = [
	{
		url: sourceUrls[0] ?? "",
		kind: "video",
		duration: 20583,
		poster: url("/assets/videos/hoshi-banner-poster-1.webp"),
	},
	{
		url: sourceUrls[1] ?? "",
		kind: "video",
		duration: 20367,
		poster: url("/assets/videos/hoshi-banner-poster-2.webp"),
	},
	{
		url: sourceUrls[2] ?? "",
		kind: "video",
		duration: 4400,
		poster: url("/assets/videos/hoshi-banner-poster-3.webp"),
	},
	{
		url: sourceUrls[3] ?? "",
		kind: "video",
		duration: 5500,
		poster: url("/assets/videos/hoshi-banner-poster-4.webp"),
	},
]
	.filter((item) => item.url)
	.slice(0, sourceUrls.length);
const hasMultiple = sourceUrls.length > 1;
const posterUrls = mobileMedia.map((item) => item.poster);
---

{
	sourceUrls.length > 0 && (
		<div
			id="bg-player-overlay"
			class="absolute inset-0 z-15 overflow-hidden pointer-events-none select-none"
			aria-hidden="true"
		>
			<div
				id="bg-player-mobile-carousel"
				class="absolute inset-0 block size-full pointer-events-none select-none md:hidden"
				aria-hidden="true"
			>
				{mobileMedia.map((media, index) => (
					<div
						class:list={[
							"mobile-bg-slide absolute inset-0 block size-full transition-opacity duration-1000",
							index === 0 ? "opacity-100" : "opacity-0",
						]}
						data-slide-index={index}
						data-kind={media.kind}
						data-duration={media.duration}
						style={`display: ${index === 0 ? "block" : "none"}; opacity: 1;`}
					>
						{media.kind === "image" ? (
							<picture class="block size-full">
								<source
									srcset={index === 0 ? media.url : undefined}
									data-srcset={media.url}
									type="image/webp"
									media="(max-width: 767px)"
								/>
								<img
									src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
									alt=""
									aria-hidden="true"
									class="size-full object-cover pointer-events-none select-none"
									style="filter: brightness(0.78); pointer-events: none; touch-action: none;"
								/>
							</picture>
						) : (
							<div class="relative size-full">
								<img
									src={media.poster}
									alt=""
									aria-hidden="true"
									class="absolute inset-0 size-full object-cover pointer-events-none select-none"
									style="filter: brightness(0.78); pointer-events: none; touch-action: none;"
								/>
								<video
									muted
									loop
									playsinline
									preload="metadata"
									poster={media.poster}
									disablepictureinpicture
									disableRemotePlayback
									tabindex="-1"
									aria-hidden="true"
									class="mobile-bg-video absolute inset-0 size-full object-cover pointer-events-none select-none"
									style="filter: brightness(0.78); pointer-events: none; touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;"
									x-webkit-airplay="deny"
									webkit-playsinline="true"
								>
									<source data-src={media.url} type="video/mp4" />
								</video>
							</div>
						)}
					</div>
				))}
			</div>

			<video
				id="bg-player-video"
				autoplay
				muted
				loop={!hasMultiple}
				playsinline
				preload="metadata"
				poster={posterUrls[0]}
				disablepictureinpicture
				disableRemotePlayback
				tabindex="-1"
				aria-hidden="true"
				class="hidden size-full object-cover pointer-events-none select-none md:block"
				style="filter: brightness(0.78); pointer-events: none; touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;"
				x-webkit-airplay="deny"
				webkit-playsinline="true"
			>
				<source src={sourceUrls[0]} type="video/mp4" media="(min-width: 768px)" />
			</video>
		</div>
	)
}

<script
	is:inline
	define:vars={{
		desktopUrls: JSON.stringify(sourceUrls),
		desktopPosters: JSON.stringify(posterUrls),
		playerMode,
	}}
>
	(() => {
		var desktopList = JSON.parse(desktopUrls);
		var posterList = JSON.parse(desktopPosters);
		var isMobile = window.matchMedia("(max-width: 767px)").matches;

		function nextIndex(current, length) {
			if (length <= 1) return 0;
			if (playerMode === "random") {
				var next;
				do { next = Math.floor(Math.random() * length); } while (next === current);
				return next;
			}
			return (current + 1) % length;
		}

		if (isMobile) {
			var carousel = document.getElementById("bg-player-mobile-carousel");
			if (!carousel || carousel.getAttribute("data-carousel-init")) return;
			carousel.setAttribute("data-carousel-init", "true");
			var slides = Array.from(carousel.querySelectorAll(".mobile-bg-slide"));
			var currentSlide = 0;

			function getSlideVideo(index) {
				return slides[index] && slides[index].querySelector(".mobile-bg-video");
			}

			function loadSlide(index) {
				var slide = slides[index];
				if (!slide) return;
				var source = slide.querySelector("source");
				if (!source) return;
				if (slide.getAttribute("data-kind") === "video") {
					if (!source.getAttribute("src")) {
						source.setAttribute("src", source.getAttribute("data-src") || "");
						var slideVideo = getSlideVideo(index);
						if (slideVideo) slideVideo.load();
					}
				} else if (!source.getAttribute("srcset")) {
					source.setAttribute("srcset", source.getAttribute("data-srcset") || "");
				}
			}

			function playSlideVideo(index) {
				var slideVideo = getSlideVideo(index);
				if (!slideVideo) return;
				slideVideo.muted = true;
				slideVideo.defaultMuted = true;
				slideVideo.autoplay = true;
				slideVideo.loop = true;
				slideVideo.playsInline = true;
				slideVideo.controls = false;
				try { slideVideo.currentTime = 0; } catch (_) {}
				var promise = slideVideo.play();
				if (promise && typeof promise.catch === "function") {
					promise.catch(function () {});
				}
			}

			function stopSlideVideo(index) {
				var slideVideo = getSlideVideo(index);
				if (slideVideo) slideVideo.pause();
			}

			function scheduleNext() {
				if (slides.length <= 1) return;
				var duration = Number(slides[currentSlide].getAttribute("data-duration")) || 20400;
				var timer = setTimeout(function () {
					var next = nextIndex(currentSlide, slides.length);
					loadSlide(next);
					stopSlideVideo(currentSlide);
					slides[currentSlide].style.display = "none";
					slides[next].style.display = "block";
					slides[next].style.opacity = "1";
					currentSlide = next;
					playSlideVideo(currentSlide);
					scheduleNext();
				}, duration);
				Reflect.set(window, "__hoshiMobileCarouselTimer", timer);
			}

			var oldTimer = Reflect.get(window, "__hoshiMobileCarouselTimer");
			if (oldTimer) clearTimeout(oldTimer);
			loadSlide(0);
			playSlideVideo(0);
			function unlockMobileVideo() {
				playSlideVideo(currentSlide);
				document.removeEventListener("pointerdown", unlockMobileVideo, true);
				document.removeEventListener("touchend", unlockMobileVideo, true);
			}
			document.addEventListener("pointerdown", unlockMobileVideo, true);
			document.addEventListener("touchend", unlockMobileVideo, true);
			scheduleNext();
			return;
		}

		var video = document.getElementById("bg-player-video");
		if (!video || !desktopList.length || video.getAttribute("data-background-video-init")) return;
		video.setAttribute("data-background-video-init", "true");
		var currentVideo = 0;

		function enforceBackgroundMode() {
			video.muted = true;
			video.defaultMuted = true;
			video.autoplay = true;
			video.loop = desktopList.length === 1;
			video.playsInline = true;
			video.controls = false;
			video.removeAttribute("controls");
			video.setAttribute("playsinline", "");
			video.setAttribute("webkit-playsinline", "true");
			var playPromise = video.play();
			if (playPromise && typeof playPromise.catch === "function") {
				playPromise.catch(function () {});
			}
		}

		function switchVideo() {
			currentVideo = nextIndex(currentVideo, desktopList.length);
			video.poster = posterList[currentVideo] || "";
			video.src = desktopList[currentVideo];
			video.load();
			enforceBackgroundMode();
		}

		video.addEventListener("loadeddata", enforceBackgroundMode);
		video.addEventListener("canplay", enforceBackgroundMode);
		video.addEventListener("ended", switchVideo);
		video.addEventListener("pause", function () {
			if (!document.hidden && !video.ended) setTimeout(enforceBackgroundMode, 100);
		});
		window.addEventListener("pageshow", enforceBackgroundMode);
		window.addEventListener("focus", enforceBackgroundMode);
		document.addEventListener("visibilitychange", function () {
			if (!document.hidden) enforceBackgroundMode();
		});

		enforceBackgroundMode();
	})();
</script>

<style>
	:global(#banner-images-container),
	:global(#banner-dim-container),
	:global(#header-waves),
	:global(#wallpaper-gradient) {
		opacity: 0 !important;
	}
</style>
